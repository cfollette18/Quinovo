{
  "name": "quinovo-eval-templates",
  "version": "0.1.0",
  "description": "LLM judges for Quinovo MCP agents: one failure mode each, attach to the run.",
  "companion": "https://github.com/cfollette18/agent-eval-templates",
  "categories": [
    {
      "id": "contract",
      "description": "Did the agent write the turn into the world pack as typed objects?",
      "rule": "rules/contract.json"
    },
    {
      "id": "interface",
      "description": "Did the agent leave the Quinovo MCP surface?",
      "rule": "rules/interface.json"
    },
    {
      "id": "authoring",
      "description": "Did pack, rule, and type changes go through propose instead of YAML?",
      "rule": "rules/authoring.json"
    },
    {
      "id": "governance",
      "description": "Did the agent honor HITL and named actions?",
      "rule": "rules/governance.json"
    },
    {
      "id": "epistemics",
      "description": "Did claims about the twin come from Quinovo reads?",
      "rule": "rules/epistemics.json"
    }
  ],
  "templates": [
    {
      "id": "save_turn_called",
      "category": "contract",
      "path": "templates/contract/save_turn_called/template.json"
    },
    {
      "id": "structured_capture",
      "category": "contract",
      "path": "templates/contract/structured_capture/template.json"
    },
    {
      "id": "mcp_bypass",
      "category": "interface",
      "path": "templates/interface/mcp_bypass/template.json"
    },
    {
      "id": "propose_not_author",
      "category": "authoring",
      "path": "templates/authoring/propose_not_author/template.json"
    },
    {
      "id": "hitl_respected",
      "category": "governance",
      "path": "templates/governance/hitl_respected/template.json"
    },
    {
      "id": "named_action",
      "category": "governance",
      "path": "templates/governance/named_action/template.json"
    },
    {
      "id": "twin_first",
      "category": "epistemics",
      "path": "templates/epistemics/twin_first/template.json"
    }
  ]
}

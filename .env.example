# Copy to .env. Tracing is a no-op until both keys are set.
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL="http://localhost:3000"
LANGFUSE_TRACING_ENVIRONMENT="development"
# Optional. Human turn-downs land here as training items when disagreement is true.
# LANGFUSE_DISAGREEMENT_DATASET="training/user-disagreement"
